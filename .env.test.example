# Orivory test environment example
# Used by live integration tests and the CI compose stack.

# One container, zero external services: SQLite is the only supported store.
DATABASE_URL=sqlite+aiosqlite:////tmp/orivory-test.db

# The install's one identity — there is no account auth to configure.
LOCAL_OWNER_EMAIL=owner@orivory.local
API_BASE_URL=http://localhost:8000

# Storage: the local filesystem (there is no object-store service).
STORAGE_BACKEND=fs

QDRANT_URL=http://localhost:6333

OPENROUTER_API_KEY=test-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512

OPENAI_API_KEY=test-openai-key
EMBED_MODEL=text-embedding-3-small
EMBED_DIMENSIONS=1536
EMBED_BATCH_SIZE=64

JINA_API_KEY=test-jina-key
# The per-call CAP on the reranker's answer — NOT the rerank window (the window
# is top_k * RETRIEVAL_RERANK_POOL_MULTIPLIER; ruling R13 keeps this at/above it).
RERANK_TOP_N=20
RETRIEVAL_RERANK_POOL_MULTIPLIER=2.0
RETRIEVAL_SEMANTIC_RERANK=false
# Hybrid recall ships OFF; the lexical leg is SQLite-only (FTS5). The compose
# app reads this file, so an example-seeded deployment runs exactly this.
RETRIEVAL_HYBRID_ENABLED=false
RETRIEVAL_RRF_K=60
EMBED_EXECUTOR_WORKERS=2
# 0 = ONNX Runtime's own default (all cores); raise the executor width, not
# this, unless you are deliberately capping oversubscription on a small box.
EMBED_ORT_INTRA_OP_THREADS=0
EMBED_WARMUP_ON_BOOT=true

# ── Corrective-RAG (CRAG) ─────────────────────────────────────────────────────
CRAG_ENABLED=true
CRAG_GRADING_MODEL=openai/gpt-4o-mini
CRAG_RELEVANCE_THRESHOLD=0.7
CRAG_PARTIAL_THRESHOLD=0.4
CRAG_FALLBACK_THRESHOLD=0.5
CRAG_MAX_WEB_RESULTS=10
TAVILY_API_KEY=

# ── HyDE (Hypothetical Document Embeddings) ────────────────────────────────────
HYDE_ENABLED=true
HYDE_MODEL=openai/gpt-4o-mini
HYDE_PASSAGE_COUNT=3
HYDE_USE_IN_RETRIEVAL=true

EVALUATOR_FAILURE_MODE=warn_only

RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_PER_DAY=10000

FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ENVIRONMENT=test
LOG_LEVEL=INFO
