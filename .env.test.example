# Orivory test environment example
# Used by live integration tests and CI service containers.

DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:55432/ragdb
POSTGRES_DB=ragdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_PORT=55432
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# Slim core: no Redis service — an empty URL selects the in-process InMemoryRedis.
REDIS_URL=
REDIS_POOL_MAX=10

JWT_SECRET_KEY=test-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

GOOGLE_CLIENT_ID=test-client-id
GOOGLE_CLIENT_SECRET=test-client-secret
API_BASE_URL=http://localhost:8000

SENDGRID_API_KEY=test-sendgrid-key
EMAIL_FROM=noreply@orivory.local
EMAIL_FROM_NAME=Orivory Test

# Storage: filesystem backend (the MinIO service was dropped from compose).
STORAGE_BACKEND=fs

CHROMA_HOST=localhost
CHROMA_PORT=8001

OPENROUTER_API_KEY=test-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512

OPENAI_API_KEY=test-openai-key
EMBED_MODEL=text-embedding-3-small
EMBED_DIMENSIONS=1536
EMBED_BATCH_SIZE=64

JINA_API_KEY=test-jina-key
JINA_RERANKER_MODEL=jina-reranker-v2-base-multilingual
JINA_RERANKER_TOP_N=5

# ── Corrective-RAG (CRAG) ─────────────────────────────────────────────────────
CRAG_ENABLED=true
CRAG_GRADING_MODEL=openai/gpt-4o-mini
CRAG_RELEVANCE_THRESHOLD=0.7
CRAG_PARTIAL_THRESHOLD=0.4
CRAG_FALLBACK_THRESHOLD=0.5
CRAG_MAX_WEB_RESULTS=10
TAVILY_API_KEY=

# ── HyDE (Hypothetical Document Embeddings) ────────────────────────────────────
HYDE_ENABLED=true
HYDE_MODEL=openai/gpt-4o-mini
HYDE_PASSAGE_COUNT=3
HYDE_USE_IN_RETRIEVAL=true

EVALUATOR_FAILURE_MODE=warn_only

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_PER_DAY=10000

FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ENVIRONMENT=test
LOG_LEVEL=INFO
