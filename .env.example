# =============================================================================
# Orivory Backend Environment Example
# =============================================================================
# Copy this file to .env and replace placeholder values before running the app.
# =============================================================================

# ── Canonical store (SQLite only) ─────────────────────────────────────────────
# One container, zero external services: SQLite is the ONLY supported store.
DATABASE_URL=sqlite+aiosqlite:////data/orivory.db

# ── Storage (local filesystem) ────────────────────────────────────────────────
STORAGE_BACKEND=fs
FS_STORAGE_PATH=/data/uploads

# ── Secrets encryption ────────────────────────────────────────────────────────
# Fernet key used to encrypt secrets stored at rest (Source.config).
# REQUIRED in production. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty in development - a fixed local-dev key is derived automatically.
CONFIG_ENCRYPTION_KEY=

# ── API Base URL ──────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000

# ── App Identity ──────────────────────────────────────────────────────────────
APP_NAME=Orivory
APP_TAGLINE=Personal AI Second Brain
CONTACT_EMAIL=hello@orivory.local

# The install's ONE identity. There is no account auth: every request that
# arrives without an agent token IS this owner, and this is the email of the
# single ``users`` row that owns agent tokens, memories and the ledger. An
# existing row with this email is used as-is.
# Set this BEFORE the first boot: the row (and everything keyed to it) is
# created on first boot, so renaming it later orphans the data that exists.
LOCAL_OWNER_EMAIL=owner@orivory.local

# ── Qdrant (Vector Store) ─────────────────────────────────────────────────────
# Defaults to an embedded in-process store (no API key + a localhost URL);
# set QDRANT_MODE=server + QDRANT_URL + QDRANT_API_KEY to point at a server.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── OpenRouter (LLM) ─────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=0.7
ANSWER_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
CONTEXT_CHAR_BUDGET=24000

# ── OpenAI (Embeddings) ──────────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
EMBED_MODEL=text-embedding-3-small
EMBED_DIMENSIONS=1536
EMBED_BATCH_SIZE=64

# ── Jina (Embeddings + Reranker, optional) ───────────────────────────────────
# Optional opt-in. Without an embedding key the bundled local ONNX model is the
# default (no key, no cost, 384-dim fresh store).
# Do NOT mix backends in one collection (dim guard refuses).
JINA_API_KEY=jina_xxxxxxxxxxxxxxxxxxxx
JINA_RERANKER_MODEL=jina-reranker-v2-base-multilingual
# The per-call CAP on the reranker's answer — NOT the rerank window. The window
# is the retrieval pool: `top_k * RETRIEVAL_RERANK_POOL_MULTIPLIER` below, which
# defaults to 10 * 2.0 = 20. Keep the two in step: a cap below the window leaves
# the tail of every recall on the dense x boost x decay regime (ruling R13).
JINA_RERANKER_TOP_N=20
# Rerank pool: dense candidates fetched per requested result (signed default 2.0).
RETRIEVAL_RERANK_POOL_MULTIPLIER=2.0
# One rerank HTTP call is bounded by this; overrunning it is a typed failure and
# the answer continues in dense order (counted, never fatal).
JINA_RERANKER_TIMEOUT_SECONDS=10.0
# Rerank is opt-in per deployment; V1 self-host keeps it off until eval proves need.
RETRIEVAL_SEMANTIC_RERANK=false
# Which transport serves that rerank: auto = Jina when JINA_API_KEY is set, the
# bundled ONNX cross-encoder (gte-multilingual-reranker-base int8, Apache-2.0,
# ~341 MB downloaded once into LOCAL_E5_DIR) otherwise. "jina" / "local" pin one.
RERANK_BACKEND=auto
# Hybrid recall (FTS5 lexical leg + RRF fusion). Ships OFF by ruling: only the
# T7 ablation artifact may flip it, and that flip is a separate decision.
# SQLite-only, like the rest of the stack.
RETRIEVAL_HYBRID_ENABLED=false
# The RRF constant: sum(1 / (k + rank + 1)) over zero-based ranks.
RETRIEVAL_RRF_K=60
# Lite/self-host single machine: local embeddings, zero external calls.
USE_LOCAL_EMBEDDINGS=true
# Which local model: arctic (snowflake-arctic-embed-xs, default, CLS pooling)
# or e5 (multilingual int8, opt-in Vietnamese, mean pooling).
# Both 384-dim but incompatible vectors — switching stores requires reindexing.
LOCAL_EMBED_MODEL=arctic
# Where e5 files download once on first use (persist on the data volume).
LOCAL_E5_DIR=/data/models/e5
# ── Bounded local execution (P2) ─────────────────────────────────────────────
# Every async embedding call runs on this one executor (`orivory-embed`), so the
# synchronous ONNX call never blocks the event loop. It is the ONLY width knob.
EMBED_EXECUTOR_WORKERS=2
# ONNX Runtime intra-op threads PER embedding session. 0 = ORT's own default
# (all cores). Set 1 (or fewer) only to cap OVERSUSCRIPTION on a small machine —
# the executor runs 2 concurrent embeds, each free to use every core — and
# re-measure: at 1 this box's embedding is ~4x slower and the signed
# read-your-writes budget can be missed.
EMBED_ORT_INTRA_OP_THREADS=0
# Build the local embedding session during boot, before the drain and before
# serving: a cold session is 610-685 ms and would otherwise land on a request.
# On the image the FIRST boot may download the model (no timeout) first.
EMBED_WARMUP_ON_BOOT=true

# ── AI Runtime Guardrails ─────────────────────────────────────────────────────
# warn_only/fail_open keeps answers flowing if evaluator calls fail; fail_closed is stricter.
EVALUATOR_FAILURE_MODE=warn_only

# ── Corrective-RAG (CRAG) ───────────────────────────────────────────────────
CRAG_ENABLED=true
CRAG_GRADING_MODEL=openai/gpt-4o-mini
CRAG_RELEVANCE_THRESHOLD=0.7
CRAG_PARTIAL_THRESHOLD=0.4
CRAG_FALLBACK_THRESHOLD=0.5
CRAG_MAX_WEB_RESULTS=10
TAVILY_API_KEY=

# ── HyDE (Hypothetical Document Embeddings) ───────────────────────────────────
HYDE_ENABLED=true
HYDE_MODEL=openai/gpt-4o-mini
HYDE_PASSAGE_COUNT=3
HYDE_USE_IN_RETRIEVAL=true

# ── Temporal Memory ───────────────────────────────────────────────────────────
TEMPORAL_ENABLED=true
TEMPORAL_DIM=64
TEMPORAL_HALF_LIFE_DAYS=90
TEMPORAL_WEIGHT=0.3

# ── Multi-hop Reasoning ──────────────────────────────────────────────────────
MULTIHOP_ENABLED=true
MULTIHOP_MODEL=openai/gpt-4o-mini
MULTIHOP_MAX_HOPS=3

# ── Feedback Pipeline ─────────────────────────────────────────────────────────
FEEDBACK_ENABLED=true
FEEDBACK_MIN_SAMPLES=1000
FEEDBACK_MIN_CORRECTIONS=50
FEEDBACK_RETENTION_DAYS=90
FEEDBACK_POSITIVE_BOOST=0.1
FEEDBACK_NEGATIVE_PENALTY=0.1
FEEDBACK_MAX_WEIGHT=2.0
FEEDBACK_MIN_WEIGHT=0.5

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_DAY=1000

# ── MCP Memory Hub ────────────────────────────────────────────────────────────
# When true, the Open Memory Hub MCP server (stateless streamable HTTP) is
# mounted at /mcp. Agent clients authenticate with their per-client bearer
# token (registered via the agents API) and are scoped via memory:read /
# memory:write; every tool call is written to the access ledger.
MCP_HUB_ENABLED=true

# Extra Host headers / hostnames allowed to reach /mcp (comma-separated).
# Empty keeps FastMCP's localhost-only DNS-rebind protection (any non-localhost
# Host header is answered 421); set it — e.g. MCP_HUB_ALLOWED_HOSTS=api.orivory.io —
# when exposing /mcp behind a reverse proxy that forwards a public Host header.
MCP_HUB_ALLOWED_HOSTS=

# ── App ───────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ENVIRONMENT=development
LOG_LEVEL=INFO
